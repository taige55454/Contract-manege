{
  "name": "contract-manager",
  "version": "2.4.2",
  "description": "Enterprise Contract & Procurement Ledger Desktop Application",
  "author": "Enterprise Contract Team",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "server": "electron -r ./server.js",
    "test": "electron test-smoke.js",
    "postinstall": "electron-builder install-app-deps",
    "dist:win": "electron-builder --win portable nsis --x64 --publish never",
    "dist:portable": "electron-builder --win portable --x64 --publish never",
    "dist:setup": "electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "electron": "^31.7.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.enterprise.contractmanager",
    "productName": "ContractManager",
    "compression": "maximum",
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "files": [
      "main.js",
      "server.js",
      "public/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.md"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        },
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "portable": {
      "artifactName": "${productName}-${version}-Portable.${ext}"
    },
    "nsis": {
      "artifactName": "${productName}-${version}-Setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "企业合同台账管理系统"
    }
  }
}
